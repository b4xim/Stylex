# Server Environment
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Client URLs for CORS (Comma-separated)
CORS_ORIGIN=https://stylexsalon.in,https://dashboard.stylexsalon.in,https://www.stylexsalon.in,https://stylexsignaturesalon.in,https://www.stylexsignaturesalon.in,http://stylexsalon.in,http://dashboard.stylexsalon.in,http://localhost:5173,http://localhost:5174

# Database Connection (PostgreSQL 16)
# Local Docker or direct connection string:
DATABASE_URL="postgresql://stylex_admin:stylex_secure_pass_2026@localhost:5432/stylex_salon?schema=public"

# JWT Authentication
JWT_SECRET="stylex_signature_secret_key_super_secure_jwt_2026"
JWT_EXPIRES_IN="7d"

# Media Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# WhatsApp Configuration:
# 1. Self-Hosted Bot (Recommended - 100% Free): 
#    Simply scan the live QR code in the Admin Dashboard Settings. No token needed!
# 2. Meta WhatsApp Cloud API (Optional Enterprise Fallback):
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="stylex_webhook_secret_verify_token"
SALON_WHATSAPP_NUMBER="919656111149"

# Email Configuration (100% Free Gmail SMTP with App Password)
# Step 1: In your Google Account -> Security -> Enable 2-Step Verification
# Step 2: Search "App passwords" -> Create one named "StyleX Salon" (16 characters)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-salon-email@gmail.com"
SMTP_PASS="abcdefghijklmnop"
SMTP_FROM="StyleX Signature Salon <your-salon-email@gmail.com>"

# Initial Seed Credentials for Admin
ADMIN_DEFAULT_EMAIL="admin@stylex.com"
ADMIN_DEFAULT_PASSWORD="StyleXAdmin@2026"
ADMIN_DEFAULT_NAME="StyleX Tirur Flagship Manager"
